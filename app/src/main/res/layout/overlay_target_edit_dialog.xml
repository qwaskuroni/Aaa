<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="#1E293B"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Action Button Editor"
        android:textColor="#38BDF8"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Action Type:"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spinnerActionType"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="#334155"
        android:padding="8dp" />

    <LinearLayout
        android:id="@+id/layoutTextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Text to Input (Supports Multi-line &amp; Emoji):"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTextInput"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="4dp"
            android:background="#0F172A"
            android:gravity="top|start"
            android:hint="Type text or paste emojis here..."
            android:textColorHint="#64748B"
            android:inputType="textMultiLine|textCapSentences|textShortMessage"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="✓ Saved automatically"
            android:textColor="#10B981"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutVideoInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Video from Gallery:"
            android:textColor="#FF2D55"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPickGalleryVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:backgroundTint="#FF2D55"
            android:text="🎥 Select Video from Gallery"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etVideoUri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#0F172A"
            android:hint="Selected Video URI or Path..."
            android:textColorHint="#64748B"
            android:inputType="textUri|textMultiLine"
            android:padding="8dp"
            android:textColor="#38BDF8"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="✓ Selected video will play in small window when step reaches this target."
            android:textColor="#10B981"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutUnreadChatsInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📩 Open Unread Chats Settings:"
            android:textColor="#10B981"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Minimum Unread Count:"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/etMinUnreadCount"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="#0F172A"
            android:inputType="number"
            android:padding="6dp"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Process Order:"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <Spinner
            android:id="@+id/spinnerProcessOrder"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="#334155"
            android:padding="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Maximum Chats to Open (0 = All):"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/etMaxChatsToOpen"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="#0F172A"
            android:inputType="number"
            android:padding="6dp"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/cbSkipPinned"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Skip pinned chats"
            android:textColor="#CBD5E1"
            android:textSize="11sp" />

        <CheckBox
            android:id="@+id/cbSkipMuted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skip muted chats"
            android:textColor="#CBD5E1"
            android:textSize="11sp" />

        <CheckBox
            android:id="@+id/cbAutoScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Auto scroll to continue scanning"
            android:textColor="#CBD5E1"
            android:textSize="11sp" />

        <CheckBox
            android:id="@+id/cbStopAtEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Stop when end of list is reached"
            android:textColor="#CBD5E1"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutSmartScannerInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍 Smart Message Scanner Settings:"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="✓ Automatically extracts the latest unread customer text."
            android:textColor="#CBD5E1"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="✓ Ignores voice notes, call logs, photos, videos, stickers, gifs, urls, emoji-only, &amp; system msgs."
            android:textColor="#94A3B8"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Saved in Variable: {{SCANNED_MESSAGE}}"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutXlsReplyInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊 XLS Smart Reply Engine:"
            android:textColor="#A855F7"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPickExcelFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:backgroundTint="#8B5CF6"
            android:text="📁 Upload Excel (.xlsx) File"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etExcelFilePath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#0F172A"
            android:hint="Selected Excel File Path or URI..."
            android:textColorHint="#64748B"
            android:padding="6dp"
            android:textColor="#A855F7"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Or Enter Rules (Keyword : Reply):"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/etExcelRulesContent"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="2dp"
            android:background="#0F172A"
            android:gravity="top|start"
            android:hint="Col A Keyword : Col B Reply\nExample:\nনাম্বার, বিকাশ, নগদ : 01889411602\nদাম কত : ৫০০ টাকা"
            android:textColorHint="#64748B"
            android:inputType="textMultiLine"
            android:padding="6dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Minimum Match Confidence (0.1 - 1.0):"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/etMatchThreshold"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="#0F172A"
            android:inputType="numberDecimal"
            android:padding="6dp"
            android:text="0.3"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Fallback Reply (If no match):"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/etFallbackReply"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="#0F172A"
            android:padding="6dp"
            android:hint="Leave empty or fallback message"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="✓ Saved in Variable: {{AUTO_REPLY}}"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Delay Before Action (ms):"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etDelayMs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:text="500"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Press Duration (ms):"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etDurationMs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:text="100"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Button Size (px):"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDecreaseSize"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:backgroundTint="#334155"
            android:padding="0dp"
            android:text="-"
            android:textColor="#FFFFFF" />

        <EditText
            android:id="@+id/etSizePx"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:inputType="number"
            android:text="96"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnIncreaseSize"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:backgroundTint="#334155"
            android:padding="0dp"
            android:text="+"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDuplicate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#0284C7"
            android:text="Duplicate"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#EF4444"
            android:text="Delete"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#94A3B8" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#00E5FF"
            android:text="Save"
            android:textColor="#0F172A" />
    </LinearLayout>

</LinearLayout>
